    },
    {
      "page": "/[lang]/faq",
      "regex": "^/([^/]+?)/faq(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/faq(?:/)?$"
    },
    {
      "page": "/[lang]/gallery",
      "regex": "^/([^/]+?)/gallery(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/gallery(?:/)?$"
    },
    {
      "page": "/[lang]/how-to-order",
      "regex": "^/([^/]+?)/how\\-to\\-order(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/how\\-to\\-order(?:/)?$"
    },
    {
      "page": "/[lang]/party-packages",
      "regex": "^/([^/]+?)/party\\-packages(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
