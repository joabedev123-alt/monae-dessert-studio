        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/contact(?:/)?$"
    },
    {
      "page": "/[lang]/desserts",
      "regex": "^/([^/]+?)/desserts(?:/)?$",
